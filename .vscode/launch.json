{
    "version": "0.2.0",
    "configurations": [
        {
            "name":"LLM RPC server",
            "type":"debugpy",
            "request":"launch",
            "python": "${workspaceFolder}/llm_rpc_server/venv-rpc/bin/python3.13",
            "cwd": "${workspaceFolder}/llm_rpc_server",
            "program":"rpc_server.py",
            "console":"integratedTerminal",
            "env": {
                "CHROMA": "0.0.0.0"
            }
        },
        {
            "name": "Gigachat debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/gigachat-service/venv-gigachat/bin/python3.13",
            "cwd": "${workspaceFolder}/gigachat-service",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8001"
            ],
            "jinja": true,
            "env": {
                "CHROMA": "0.0.0.0"
            }
        },
        {
            "name": "Deepseek debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/deepseek-service",
            "python": "${workspaceFolder}/deepseek-service/venv-deepseek/bin/python3.13",
            "args": [
                "entrypoint:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8002"
            ],
            "jinja": true,
            "env": {
                "CHROMA": "0.0.0.0"
            }
        },
        {
            "name": "ChromaDB Debug",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/chromadb-service/venv-chroma/bin/python3.13",
            "program": "${workspaceFolder}/chromadb-service/app/__main__.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/chromadb-service"
        },
        {
            "name": "Agent Debug",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/agent_app/venv-agent/bin/python",
            "program": "${workspaceFolder}/agent_app/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/agent_app",
            "env": {
                "LLM": "http://localhost:8002",
                "LLM_SELECTED": "deepseek-r1",
                "LOG_PROMPTS": "True",
                "TPS": "30",
                "RMQ": "http://localhost:5672",
                "ACTIVE_LLMS": "1"
            },
            // "preLaunchTask": "Start Containers"
        },
        {
            "name": "Agent Debug Remote",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/agent_app/venv-agent/bin/python",
            "program": "${workspaceFolder}/agent_app/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/agent_app",
            "env": {
                "LLM": "http://?????????????:8002",
                "LLM_SELECTED": "deepseek-r1",
                "LOG_PROMPTS": "True",
                "TPS": "15",
                "RMQ": "http://?????????????:5672",
                "ACTIVE_LLMS": "1"
            },
            // "preLaunchTask": "Start Containers"
        }
    ]
}